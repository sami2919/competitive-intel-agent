# Competitive Intel Agent — environment template.
# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for demo mode;
# live mode requires all data-API keys (mode-aware validation at startup).

# --- LLMs ---
ANTHROPIC_API_KEY=sk-ant-...      # orchestrator (Sonnet) + extractor (Haiku) — REQUIRED (all modes)
OPENAI_API_KEY=sk-...             # Layer-2 judge (gpt-4o-mini) — run `make eval-judge COMPETITOR=gusto.com`
GEMINI_API_KEY=                   # alternate Layer-2 judge (gemini-2.5-flash) — used if OPENAI_API_KEY is unset

# --- Data APIs (live mode only) ---
SCRAPECREATORS_API_KEY=           # Meta + Google Ad Library (100 free credits)
FIRECRAWL_API_KEY=                # site crawl: /map + /scrape (500 free credits)
EXA_API_KEY=                      # news / press search (free tier)
APIFY_API_TOKEN=                  # optional fallback for Meta ads; also powers linkedin_posts (free tier; APIFY_API_KEY also accepted)
SERPAPI_API_KEY=                  # optional fallback for Google ads (50 free searches/mo)

# --- Run mode ---
# INTEL_MODE=live   # live = require all keys; demo = require only ANTHROPIC_API_KEY
